rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify admin / employer role
    function isEmployer() {
      return isAuthenticated() && 
        (request.auth.token.role == 'employer' || 
         request.auth.token.role == 'admin');
    }

    // Helper function to verify if request is from the record owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Worker Profiles: Workers can read their own profile; Employers can read/write all
    match /workerProfiles/{workerId} {
      allow read: if isOwner(workerId) || isEmployer();
      allow create, update, delete: if isEmployer();
    }

    // Attendance & Shifts: Workers can create check-in/out for themselves; Employers can review/update
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (resource.data.workerId == request.auth.uid || isEmployer());
      allow create: if isAuthenticated() && request.resource.data.workerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.workerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkOutTime', 'notes', 'status'])) || 
        isEmployer()
      );
      allow delete: if isEmployer();
    }

    // Transparent Payroll: Workers can ONLY view their own payslips; Only authorized employers can calculate/approve
    match /payroll/{payrollId} {
      allow read: if isAuthenticated() && (resource.data.workerId == request.auth.uid || isEmployer());
      allow write: if isEmployer();
    }

    // Safety Reports: Any worker can submit a safety complaint; Can only update their own report before review; Employers review & resolve
    match /safetyReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isEmployer() || (isAuthenticated() && resource.data.workerId == request.auth.uid);
      allow delete: if isEmployer();
    }

    // Anonymous Feedback: Write-only for workers; Employers can read aggregate feedback without worker identity
    match /anonymousFeedback/{feedbackId} {
      allow create: if true; // Allows untraceable submissions
      // Guarantee worker anonymity: Ensure no identifying personal fields exist in the payload
      allow read: if isEmployer();
      allow update, delete: if isEmployer();
    }

    // Digital Skill Passport: Publicly verifiable / portable or read by worker & employers
    match /skillPassports/{workerId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(workerId) || isEmployer();
    }

    // Audit Logs: Append-only by system / employers; Read by employers only
    match /auditLogs/{logId} {
      allow read: if isEmployer();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log
    }
  }
}
